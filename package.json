{
  "name": "rolling-board-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --clear-screen=false index.ts",
    "build": "rimraf ./dist && esbuild index.ts --bundle --outdir=dist --platform=node --format=esm --packages=external",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "fix-code": "npm run format:fix && npm run lint:fix",
    "generate-dockerrun": "node ./scripts/generateDockerrun.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/request-context": "^6.0.2",
    "@prisma/adapter-pg": "^6.3.1",
    "@prisma/client": "^6.3.1",
    "@types/express": "^5.0.6",
    "aws-jwt-verify": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.13.3",
    "zod": "^3.24.2",
    "zod-prisma-types": "^3.2.4",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@stylistic/eslint-plugin-js": "^3.1.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "chalk": "^5.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "minimist": "^1.2.8",
    "prettier": "^3.5.1",
    "prisma": "^6.3.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
