model Project {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name        String  
  description String 
  createdBy   String
  createdByUser User  @relation(fields: [createdBy], references:[id])

  memberships Membership[]
  columns   Column[]

  @@index([name])
  @@index([description])
  @@map("projects")
}
model Membership {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectId String
  project   Project @relation(fields:[projectId],references:[id])

  userId    String
  user      User    @relation(fields:[userId],references:[id])

  @@unique([projectId,userId])
  @@index([projectId])
  @@index([userId])
  @@map("memberships")
}
model Column {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  name      String
  order     Int

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  // future
  // tasks     Task[]

  @@index([projectId])
  @@index([projectId, order])
  @@map("columns")
}