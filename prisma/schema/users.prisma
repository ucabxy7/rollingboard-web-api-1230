model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  username  String @unique
  email     String @unique
  cognitoId String @unique

  memberships Membership[]
  projectsCreated Project[]
  assignedTasks Task[]

  @@index([cognitoId])
  @@index([email])
  @@index([username])
  @@map("users")
}
